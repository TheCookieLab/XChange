<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.thecookielab.xchange</groupId>
        <artifactId>xchange-parent</artifactId>
        <version>1.0.2</version>
    </parent>

    <artifactId>xchange-uniswap</artifactId>

    <name>XChange Uniswap</name>
    <description>XChange implementation for Uniswap v4 on Ethereum mainnet</description>

    <url>http://knowm.org/open-source/xchange/</url>
    <inceptionYear>2012</inceptionYear>

    <organization>
        <name>The Cookie Lab</name>
    </organization>

    <dependencies>

        <dependency>
            <groupId>com.github.thecookielab.xchange</groupId>
            <artifactId>xchange-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>core</artifactId>
            <exclusions>
                <!-- Uniswap module uses HTTP JSON-RPC only; drop unused transports and
                     the runtime-scoped AWS KMS signing dependency from the resolved graph. -->
                <exclusion>
                    <groupId>com.github.jnr</groupId>
                    <artifactId>jnr-unixsocket</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>logging-interceptor</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.java-websocket</groupId>
                    <artifactId>Java-WebSocket</artifactId>
                </exclusion>
                <!-- tuweni-bytes' optional vertx Buffer interop drags a netty 4.1 graph into a
                     reactor that manages netty 4.2; web3j never references vertx classes -->
                <exclusion>
                    <groupId>io.vertx</groupId>
                    <artifactId>vertx-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>kms</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
